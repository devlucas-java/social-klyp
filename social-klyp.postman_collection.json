{
  "info": {
    "name": "Social Klyp API",
    "_postman_id": "social-klyp-collection",
    "description": "Complete API collection for Social Klyp backend.\n\n**Base URL:** {{baseUrl}}\n\n**Auth:** All protected endpoints require Bearer JWT.\nRun 'Login' or 'Register' first — the token is saved automatically to {{token}}.\n\n**WebSocket:** See the 'WebSocket (STOMP)' folder for connection instructions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",    "value": "http://localhost:8888",                          "type": "string" },
    { "key": "token",      "value": "",                                               "type": "string" },
    { "key": "profileId",  "value": "00000000-0000-0000-0000-000000000000",           "type": "string" },
    { "key": "postId",     "value": "00000000-0000-0000-0000-000000000000",           "type": "string" },
    { "key": "commentId",  "value": "00000000-0000-0000-0000-000000000000",           "type": "string" },
    { "key": "chatId",     "value": "00000000-0000-0000-0000-000000000000",           "type": "string" },
    { "key": "messageId",  "value": "00000000-0000-0000-0000-000000000000",           "type": "string" },
    { "key": "linkId",     "value": "00000000-0000-0000-0000-000000000000",           "type": "string" },
    { "key": "mediaId",    "value": "00000000-0000-0000-0000-000000000000",           "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Register",
          "event": [{ "listen": "test", "script": { "exec": ["if(pm.response.code===200){pm.collectionVariables.set('token',pm.response.json().token);}"], "type": "text/javascript" } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Lucas\",\n  \"lastName\": \"Silva\",\n  \"birthDay\": \"2000-01-01\",\n  \"username\": \"lucasdev123\",\n  \"email\": \"lucas@klyp.com\",\n  \"business\": false,\n  \"password\": \"!12345678\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["if(pm.response.code===200){pm.collectionVariables.set('token',pm.response.json().token);}"], "type": "text/javascript" } }],
